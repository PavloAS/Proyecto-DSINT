package reglas

import modelo.*;

rule "Inicializar hechos por defecto de los Mitos"
	salience 100
	when
	then
		//Semidioses
		Semidios perseo = new Semidios("Perseo");
		perseo.setTienePadre("Zeus");
		perseo.setTieneMadre("Danae");
		insert(perseo);
		insert(new Heroe("Perseo"));
		
		Semidios heracles = new Semidios("Heracles");
		insert(new Heroe("Heracles"));
		heracles.setTienePadre("Zeus");
		insert(heracles);
		insert(new TieneCapacidad("Heracles", "Fuerza"));
		
		//Dioses
		insert(new Dios("Zeus"));
		insert(new Dios("Poseidon"));
		insert(new Dios("Atenea"));
		insert(new Dios("Hermes"));
		insert(new Dios("Hades"));
		insert(new Dios("Hefesto"));
		
		//Humanos
		insert(new Humano("Danae"));
		insert(new Humano("Casiopea"));
		Humano andromeda = new Humano ("Andromeda");
		andromeda.setTieneMadre("Casiopea");
		insert(andromeda);
		
		Humano teseo = new Humano("Teseo");
		insert(new Heroe("Teseo")); 
		insert(teseo);
		
		insert(new Humano("Minos"));
		Humano ariadna = new Humano("Ariadna");
		ariadna.setTienePadre("Minos");
		insert(ariadna);
		insert(new Humano("Atalanta"));
		insert(new Heroe("Atalanta"));
		
		insert(new Humano("Dedalo"));
		Humano icaro = new Humano("Icaro");
		icaro.setTienePadre("Dedalo");
		insert(icaro);
		
		//Grupos, Criaturas y Lugares
		insert(new Grupo("Grayas"));
		insert(new Grupo("Ninfas"));
		insert(new Lugar("Laberinto"));
		
		Monstruo ceto = new Monstruo("Ceto");
		ceto.setEstadoLibertad("preso");
		insert(ceto);
		insert(new EstaPresoPor("Ceto", "Poseidon"));
		
		insert(new Monstruo("Medusa"));
		
		Monstruo minotauro = new Monstruo("Minotauro");
		minotauro.setEstadoLibertad("preso");
		insert(minotauro);
		insert(new EstaPresoPor("Minotauro", "Minos"));
		
		//Objetos y poseedores
		Proteccion escudo = new Proteccion("Escudo de Bronce");
		escudo.setPerteneceASer("Atenea");
		insert(escudo);
		
		Arma hoz = new Arma("Hoz de Acero");
		hoz.setPerteneceASer("Hermes");
		insert(hoz);
		
		ObjetoMagico casco = new ObjetoMagico("Casco de Hades");
		casco.setPerteneceASer("Hades");
		insert(casco);
		
		ObjetoMagico zurron = new ObjetoMagico("Zurron Magico");
		zurron.setPerteneceASer("Ninfas");
		insert(zurron);
		
		ObjetoMagico sandalias = new ObjetoMagico("Sandalias Aladas");
		sandalias.setPerteneceASer("Ninfas");
		insert(sandalias);
		
		ObjetoMagico ojo = new ObjetoMagico("Ojo de las Grayas");
		ojo.setPerteneceASer("Grayas");
		insert(ojo);
		
		Trofeo cabezaMedusa = new Trofeo("Cabeza de Medusa");
		cabezaMedusa.setPerteneceASer("Medusa");
		insert(cabezaMedusa);
		
		Trofeo cabezaCeto = new Trofeo("Cabeza de Ceto");
		cabezaCeto.setPerteneceASer("Ceto");
		insert(cabezaCeto);
		
		Herramienta hilo = new Herramienta("Hilo de Ariadna");
		hilo.setPerteneceASer("Ariadna");
		insert(hilo);

		Arma espadaTeseo = new Arma("Espada de Teseo");
		espadaTeseo.setPerteneceASer("Teseo");
		insert(espadaTeseo);

		Arma cuerno = new Arma("Cuerno del Minotauro");
		cuerno.setPerteneceASer("Minotauro");
		insert(cuerno);

		Trofeo cabezaMinotauro = new Trofeo("Cabeza del Minotauro");
		cabezaMinotauro.setPerteneceASer("Minotauro");
		insert(cabezaMinotauro);

		Herramienta cera = new Herramienta("Cera de Abejas");
		cera.setPerteneceASer("Laberinto");
		insert(cera);
		
		Herramienta plumas = new Herramienta("Plumas de Aves");
		plumas.setPerteneceASer("Laberinto");
		insert(plumas);
		
		//Capacidades
		insert(new OtorgaCapacidad("Sandalias Aladas", "Vuelo"));
		insert(new OtorgaCapacidad("Alas de Dedalo", "Vuelo"));
		insert(new OtorgaCapacidad("Alas de Icaro", "Vuelo"));
		insert(new OtorgaCapacidad("Casco de Hades", "Invisibilidad"));
		insert(new OtorgaCapacidad("Escudo-Espejo", "Reflejo"));
		insert(new OtorgaCapacidad("Cabeza de Medusa", "Petrificacion"));
		
		//Mision
//		insert(new Mision("Liberar a Andromeda", "Liberar", "Perseo", "Andromeda"));
		
		System.out.println("Mundo iniciado correctamente");
end
rule "Procesar condiciones iniciales de desposesion"
    agenda-group "informacionInicial"
    salience 200 // Se ejecuta al principio de infromacionInicial
    when
        $desposesion : String(this str[startsWith] "DESPOSEER_")
        $nombreObjeto : String() from $desposesion.substring(10)
        $objeto : Objeto(nombre == $nombreObjeto)
    then
        modify($objeto) { setPerteneceASer("Ninguno") };
        delete($desposesion);
        System.out.println("[Inicializacion] Se ha retirado el objeto " + $nombreObjeto + " de su dueño original por reglas del escenario.");
end
rule "Inferir capacidad por posesion de objeto"
	agenda-group "historia"
	salience 50
	when
		$obj : Objeto($nombreObj : nombre, $dueno : perteneceASer != null && perteneceASer != "Ninguno", estaRoto == false)
		OtorgaCapacidad(objeto == $nombreObj, $cap : capacidad)
	then
		insertLogical(new TieneCapacidad($dueno, $cap));
		System.out.println("[Capacidad] " + $dueno + " adquiere la capacidad de " + $cap + " gracias a " + $nombreObj);
end		
		
	//MITO DE PERSEO Y ANDROMEDA, encadenamiento hacia delante 	
		
rule "Poseidon libera a Ceto por enfado con Casiopea"
    agenda-group "historia"
    when
        TieneEnfadoDe(personaje == "Casiopea", ser == "Poseidon")
        $ceto : Monstruo(nombre == "Ceto", estadoLibertad == "preso")
        $presoCeto : EstaPresoPor(ser == "Ceto", captor == "Poseidon")
    then
        delete($presoCeto);
        modify($ceto) { setEstadoLibertad("libre") };
        System.out.println("[Mito] Poseidon, enojado con Casiopea, libera al monstruo Ceto.");
end

rule "Ceto apresa a Andromeda"
    agenda-group "historia"
    when
        TieneEnfadoDe(personaje == "Casiopea", ser == "Poseidon")
        Monstruo(nombre == "Ceto", estadoVida == "vivo", estadoLibertad == "libre")
        $andromeda : Humano(nombre == "Andromeda", tieneMadre == "Casiopea", estadoLibertad == "libre")
        not Accion(tipo == "Liberar", pacienteAccion == "Andromeda")
    then
        modify($andromeda) { setEstadoLibertad("preso") };
        insert(new EstaPresoPor("Andromeda", "Ceto"));
        System.out.println("[Mito] Ceto apresa a Andromeda.");
end

rule "Atenea entrega el Escudo de Bronce"
    agenda-group "historia"
	when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneFavorDe(personaje == $h, ser == "Atenea")
        $escudo : Proteccion(nombre == "Escudo de Bronce", perteneceASer == "Atenea")
    then
        modify($escudo) { setPerteneceASer($h) };
        System.out.println("[Mito] Atenea otorga el Escudo de Bronce a " + $h + ".");
end
		
rule "Hefesto pule el Escudo de Bronce y lo convierte en Escudo-Espejo"
    agenda-group "historia"
	when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneFavorDe(personaje == $h, ser == "Hefesto")
        $escudo : Proteccion(nombre == "Escudo de Bronce", perteneceASer == $h)
    then
        delete($escudo);
        Proteccion espejo = new Proteccion("Escudo-Espejo");
        espejo.setPerteneceASer($h);
        insert(espejo);
        System.out.println("[Mito] Hefesto pule el Escudo de Bronce de " + $h + " convirtiendolo en el Escudo-Espejo.");
end

rule "Hermes entrega la Hoz de Acero"
    agenda-group "historia"
	when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneFavorDe(personaje == $h, ser == "Hermes")
        $hoz : Arma(nombre == "Hoz de Acero", perteneceASer == "Hermes")
    then
        modify($hoz) { setPerteneceASer($h) };
        System.out.println("[Mito] Hermes entrega la Hoz de Acero a " + $h + ".");
end

rule "Hades entrega el Casco de Hades"
    agenda-group "historia"
	when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneFavorDe(personaje == $h, ser == "Hades")
        $casco : ObjetoMagico(nombre == "Casco de Hades", perteneceASer == "Hades")
    then
        modify($casco) { setPerteneceASer($h) };
        System.out.println("[Mito] Hades entrega su Casco de Invisibilidad a " + $h + ".");
end

rule "El heroe localiza a las Grayas con el favor de los dioses"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneFavorDe(personaje == $h, ser == "Atenea")
        TieneFavorDe(personaje == $h, ser == "Hermes")
        TieneFavorDe(personaje == $h, ser == "Hades")
        not Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Grayas")
    then
        insert(new Accion("Localizar a las Grayas", "Localizar", $h, "Grayas"));
        System.out.println("[Mito] Gracias al favor de Atenea, Hermes y Hades, " + $h + " localiza a las Grayas.");
end

rule "El heroe invisible roba el Ojo de las Grayas"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Grayas")
        TieneCapacidad(ser == $h, capacidad == "Invisibilidad")
        $ojo : ObjetoMagico(nombre == "Ojo de las Grayas", perteneceASer == "Grayas")
        not Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Ninfas")
    then
        modify($ojo) { setPerteneceASer($h) };
        System.out.println("[Mito] " + $h + " usa su invisibilidad para robar el Ojo de las Grayas.");
end

rule "El heroe devuelve el Ojo a las Grayas y localiza a las Ninfas"
    agenda-group "historia"
	when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        $ojo : ObjetoMagico(nombre == "Ojo de las Grayas", perteneceASer == $h)
        not Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Ninfas")
    then
        modify($ojo) { setPerteneceASer("Grayas") };
        insert(new Accion("Localizar a las Ninfas", "Localizar", $h, "Ninfas"));
        System.out.println("[Mito] " + $h + " devuelve el Ojo a las Grayas a cambio de saber como localizar a las Ninfas.");
end

rule "Las Ninfas entregan sus objetos al heroe"
    agenda-group "historia"
when
    Heroe($h : nombre)
    Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
    Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Ninfas")
    $objeto : Objeto($nombre : nombre, perteneceASer == "Ninfas")
then
    modify($objeto) { setPerteneceASer($h) };
    System.out.println("[Mito] Las Ninfas entregan " + $nombre + " a " + $h + ".");
end

rule "El heroe con vuelo localiza a Medusa"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        Monstruo(nombre == "Medusa", estadoVida == "vivo")
        TieneCapacidad(ser == $h, capacidad == "Vuelo")
        not Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Medusa")
    then
        insert(new Accion("Localizar a Medusa", "Localizar", $h, "Medusa"));
        System.out.println("[Mito] " + $h + " vuela y localiza a Medusa.");
end

rule "El heroe equipado mata a Medusa, obtiene su cabeza y nace Pegaso"
    agenda-group "historia"
when
    Heroe($h : nombre)
    Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
    $medusa : Monstruo(nombre == "Medusa", estadoVida == "vivo")
    Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Medusa")
    (
        exists Arma(perteneceASer == $h, estaRoto == false)
        or
        TieneCapacidad(ser == $h, capacidad == "Fuerza")
    )
    ObjetoMagico(nombre == "Zurron Magico", perteneceASer == $h, estaRoto == false)
    TieneCapacidad(ser == $h, capacidad == "Vuelo")
    TieneCapacidad(ser == $h, capacidad == "Invisibilidad")
    TieneCapacidad(ser == $h, capacidad == "Reflejo")
    $cabeza : Trofeo(nombre == "Cabeza de Medusa", perteneceASer == "Medusa")
then
    modify($medusa) { setEstadoVida("muerto") };
    modify($cabeza) { setPerteneceASer($h) };
    AnimalMitologico pegaso = new AnimalMitologico("Pegaso");
    pegaso.setTieneMadre("Medusa");
    insert(pegaso);
    insert(new Accion("Matar a Medusa", "Matar", $h, "Medusa"));
    System.out.println("[Mito] " + $h + " derrota a Medusa y guarda su cabeza en el Zurron Magico. Nace Pegaso.");
end

rule "El heroe petrifica al monstruo captor"
    agenda-group "historia"
when
    Heroe($h : nombre)
    Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
    $monstruo : Monstruo($captor : nombre, estadoVida == "vivo", estadoLibertad == "libre")
    exists EstaPresoPor(captor == $captor)
    TieneCapacidad(ser == $h, capacidad == "Petrificacion")
    TieneCapacidad(ser == $h, capacidad == "Vuelo")
then
    modify($monstruo) { setEstadoVida("muerto") };
    insert(new Accion("Matar a " + $captor, "Matar", $h, $captor));
    System.out.println("[Mito] " + $h + " petrifica a " + $captor + ".");
end

rule "Retirar una captura si quedan otros captores"
    agenda-group "historia"
    salience 10
when
    Ser($captor : nombre, estadoVida == "muerto")
    $captura : EstaPresoPor($victima : ser, captor == $captor)
    exists EstaPresoPor(ser == $victima, captor != $captor)
then
    delete($captura);
end

rule "Liberar al prisionero cuando muere su ultimo captor"
    agenda-group "historia"
    salience 10
when
    Accion(tipo == "Matar", $h : agenteAccion, $captor : pacienteAccion)
    Ser(nombre == $captor, estadoVida == "muerto")
    $prisionero : Ser($victima : nombre, estadoVida == "vivo", estadoLibertad == "preso")
    $captura : EstaPresoPor(ser == $victima, captor == $captor)
    not EstaPresoPor(ser == $victima, captor != $captor)
then
    delete($captura);
    modify($prisionero) { setEstadoLibertad("libre") };
    insert(new Accion("Liberar a " + $victima, "Liberar", $h, $victima));
    System.out.println("[Mito] " + $h + " libera a " + $victima + ".");
end

rule "Comprobacion de la mision"
    agenda-group "historia"
    salience -10
    when
        $mision : Mision($tipo : tipo, $agente : agenteMision, $objetivo : objetivoMision, cumplida == false)
        Accion(tipo == $tipo, agenteAccion == $agente, pacienteAccion == $objetivo)
    then
        modify($mision) { setCumplida(true) };
        System.out.println(">>> [EXITO] Mision cumplida: " + $agente + " ha logrado " + $tipo + " a " + $objetivo + ". <<<");
end
		
	
rule "Mostrar estado inicial de los seres"
    agenda-group "informacionInicial"
	when
	    Ser($nombre : nombre, $vida : estadoVida, $libertad : estadoLibertad)
	then
	    System.out.println("[Inicial] " + $nombre + ": " + $vida + ", " + $libertad);
end

rule "Mostrar propietario inicial de los objetos"
    agenda-group "informacionInicial"
	when
	    Objeto($nombre : nombre, $dueno : perteneceASer)
	then
	    System.out.println("[Inicial] " + $nombre + " - propietario: " + $dueno);
end	
			
	//MITO DEL LABERINTO Y EL MINOTAURO

rule "Minos envia a Andromeda al Laberinto por enfado con Casiopea"
    agenda-group "historia"
    when
        TieneEnfadoDe(personaje == "Casiopea", ser == "Minos")
        Monstruo(nombre == "Minotauro", estadoVida == "vivo")
        Humano(nombre == "Andromeda", tieneMadre == "Casiopea", estadoVida == "vivo", estadoLibertad == "libre")
        not Accion(tipo == "Entrar", agenteAccion == "Andromeda", pacienteAccion == "Laberinto")
    then
        insert(new Accion("Entrar al Laberinto", "Entrar", "Andromeda", "Laberinto"));
        System.out.println("[Mito] Minos, enfadado con Casiopea, envia a Andromeda al Laberinto.");
end

rule "Minos envia al Laberinto a quien tiene su enfado"
    agenda-group "historia"
    salience 30
    when
        TieneEnfadoDe($p : personaje != "Casiopea" && personaje != "Dedalo", ser == "Minos")
        Personaje(nombre == $p, estadoVida == "vivo", estadoLibertad == "libre")
        Monstruo(nombre == "Minotauro", estadoVida == "vivo")
        not Accion(tipo == "Entrar", agenteAccion == $p, pacienteAccion == "Laberinto")
    then
        insert(new Accion("Entrar al Laberinto", "Entrar", $p, "Laberinto"));
        System.out.println("[Mito] Por el enfado de Minos, " + $p + " es enviado al interior del Laberinto.");
end

rule "Quien entra al Laberinto sin el Hilo de Ariadna queda preso del Minotauro"
    agenda-group "historia"
    salience 30
    when
        Accion(tipo == "Entrar", $p : agenteAccion, pacienteAccion == "Laberinto")
        $ser : Personaje(nombre == $p, estadoVida == "vivo", estadoLibertad == "libre")
        Monstruo(nombre == "Minotauro", estadoVida == "vivo")
        not Herramienta(nombre == "Hilo de Ariadna", perteneceASer == $p)
        not Accion(tipo == "Liberar", pacienteAccion == $p)
    then
        modify($ser) { setEstadoLibertad("preso") };
        insert(new EstaPresoPor($p, "Minotauro"));
        System.out.println("[Mito] " + $p + " entra al Laberinto sin el Hilo de Ariadna, se pierde y queda preso del Minotauro.");
end

rule "Ariadna entrega el Hilo de Ariadna al heroe con su favor"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneFavorDe(personaje == $h, ser == "Ariadna")
        $hilo : Herramienta(nombre == "Hilo de Ariadna", perteneceASer == "Ariadna")
    then
        modify($hilo) { setPerteneceASer($h) };
        System.out.println("[Mito] Ariadna entrega el Hilo de Ariadna a " + $h + ".");
end

rule "El heroe invisible roba el Hilo de Ariadna"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneCapacidad(ser == $h, capacidad == "Invisibilidad")
        not TieneFavorDe(personaje == $h, ser == "Ariadna")
        $hilo : Herramienta(nombre == "Hilo de Ariadna", perteneceASer == "Ariadna")
   		exists EstaPresoPor(captor == "Minotauro")
    then
        modify($hilo) { setPerteneceASer($h) };
        System.out.println("[Mito] " + $h + " usa su invisibilidad para robar el Hilo de Ariadna.");
end

rule "El heroe con el Hilo de Ariadna entra al Laberinto"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        Monstruo(nombre == "Minotauro", estadoVida == "vivo")
        Herramienta(nombre == "Hilo de Ariadna", perteneceASer == $h)
        not Accion(tipo == "Entrar", agenteAccion == $h, pacienteAccion == "Laberinto")
    then
        insert(new Accion("Entrar al Laberinto", "Entrar", $h, "Laberinto"));
        System.out.println("[Mito] " + $h + " entra al Laberinto llevando consigo el Hilo de Ariadna.");
end

rule "El heroe con el Hilo de Ariadna localiza al Minotauro"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        Monstruo(nombre == "Minotauro", estadoVida == "vivo")
        Accion(tipo == "Entrar", agenteAccion == $h, pacienteAccion == "Laberinto")
        Herramienta(nombre == "Hilo de Ariadna", perteneceASer == $h)
        not Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Minotauro")
    then
        insert(new Accion("Localizar a Minotauro", "Localizar", $h, "Minotauro"));
        System.out.println("[Mito] Gracias al Hilo de Ariadna, " + $h + " se orienta en el Laberinto y localiza al Minotauro.");
end

rule "El Minotauro apresa al heroe que lo localiza desarmado y sin fuerza"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        $ser : Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        Monstruo(nombre == "Minotauro", estadoVida == "vivo")
        Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Minotauro")
        not Arma(perteneceASer == $h, estaRoto == false)
        not TieneCapacidad(ser == $h, capacidad == "Fuerza")
        not TieneCapacidad(ser == $h, capacidad == "Petrificacion")
    then
        modify($ser) { setEstadoLibertad("preso") };
        insert(new EstaPresoPor($h, "Minotauro"));
        System.out.println("[Mito] Al enfrentarse al Minotauro sin armas ni fuerza, " + $h + " es derrotado y queda preso del Minotauro.");
end

rule "El heroe mata al Minotauro"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        $minotauro : Monstruo(nombre == "Minotauro", estadoVida == "vivo")
        Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Minotauro")
        (
            exists Arma(perteneceASer == $h, estaRoto == false)
            or
            TieneCapacidad(ser == $h, capacidad == "Fuerza")
            or
            TieneCapacidad(ser == $h, capacidad == "Petrificacion")
        )
    then
        modify($minotauro) { setEstadoVida("muerto") };
        insert(new Accion("Matar a Minotauro", "Matar", $h, "Minotauro"));
        System.out.println("[Mito] " + $h + " se enfrenta y mata al Minotauro en el Laberinto.");
end

rule "El heroe obtiene los objetos del monstruo derrotado"
    agenda-group "historia"
    salience 20
    when
        Accion(tipo == "Matar", $h : agenteAccion, $m : pacienteAccion != "Medusa")
        $objeto : Objeto($nombre : nombre, perteneceASer == $m)
    then
        modify($objeto) { setPerteneceASer($h) };
        System.out.println("[Mito] " + $h + " obtiene " + $nombre + " tras vencer a " + $m + ".");
end
		
 		//DEDALO, ICARO

rule "Minos se enfada con Dedalo tras la muerte del Minotauro"
    agenda-group "historia"
    when
        Monstruo(nombre == "Minotauro", estadoVida == "muerto")
        Humano(nombre == "Dedalo", estadoVida == "vivo", estadoLibertad == "libre")
        not TieneEnfadoDe(personaje == "Dedalo", ser == "Minos")
    then
        insert(new TieneEnfadoDe("Dedalo", "Minos"));
        System.out.println("[Mito] Al descubrir que el Minotauro ha muerto, Minos se enfada con Dedalo.");
end

rule "Minos encierra a Dedalo en el Laberinto"
    agenda-group "historia"
    when
        TieneEnfadoDe(personaje == "Dedalo", ser == "Minos")
        $dedalo : Humano(nombre == "Dedalo", estadoVida == "vivo", estadoLibertad == "libre")
        not Accion(tipo == "Liberar", pacienteAccion == "Dedalo")
    then
        modify($dedalo) { setEstadoLibertad("preso") };
        insert(new EstaPresoPor("Dedalo", "Minos"));
        System.out.println("[Mito] Minos encierra a Dedalo en el Laberinto.");
end

rule "Minos encierra a Icaro en el Laberinto junto a su padre"
    agenda-group "historia"
    when
        EstaPresoPor(ser == "Dedalo", captor == "Minos")
        $icaro : Humano(nombre == "Icaro", tienePadre == "Dedalo", estadoVida == "vivo", estadoLibertad == "libre")
        not ObjetoMagico(nombre == "Alas de Icaro")
    then
        modify($icaro) { setEstadoLibertad("preso") };
        insert(new EstaPresoPor("Icaro", "Minos"));
        System.out.println("[Mito] Minos encierra tambien a Icaro en el Laberinto junto a su padre Dedalo.");
end

rule "Dedalo recoge los materiales del Laberinto"
    agenda-group "historia"
    when
        Humano(nombre == "Dedalo", estadoVida == "vivo", estadoLibertad == "preso")
        $material : Herramienta($nombre : nombre, perteneceASer == "Laberinto")
    then
        modify($material) { setPerteneceASer("Dedalo") };
        System.out.println("[Mito] Dedalo recoge " + $nombre + " en el Laberinto.");
end

rule "Dedalo construye las Alas con la cera y las plumas"
    agenda-group "historia"
    when
        Humano(nombre == "Dedalo", estadoVida == "vivo", estadoLibertad == "preso")
        Humano(nombre == "Icaro", estadoVida == "vivo", estadoLibertad == "preso")
        $cera : Herramienta(nombre == "Cera de Abejas", perteneceASer == "Dedalo")
        $plumas : Herramienta(nombre == "Plumas de Aves", perteneceASer == "Dedalo")
    then
        delete($cera);
        delete($plumas);
        ObjetoMagico alasDedalo = new ObjetoMagico("Alas de Dedalo");
        alasDedalo.setPerteneceASer("Dedalo");
        insert(alasDedalo);
        ObjetoMagico alasIcaro = new ObjetoMagico("Alas de Icaro");
        alasIcaro.setPerteneceASer("Icaro");
        insert(alasIcaro);
        System.out.println("[Mito] Dedalo utiliza la Cera de Abejas y las Plumas de Aves para construir las Alas de Dedalo y las Alas de Icaro.");
end

rule "Dedalo escapa volando del Laberinto"
    agenda-group "historia"
    when
        $dedalo : Humano(nombre == "Dedalo", estadoVida == "vivo", estadoLibertad == "preso")
        $presoDedalo : EstaPresoPor(ser == "Dedalo", captor == "Minos")
        TieneCapacidad(ser == "Dedalo", capacidad == "Vuelo")
    then
        delete($presoDedalo);
        modify($dedalo) { setEstadoLibertad("libre") };
        insert(new Accion("Liberar a Dedalo", "Liberar", "Dedalo", "Dedalo"));
        System.out.println("[Mito] Dedalo escapa volando del Laberinto.");
end

rule "Icaro escapa volando del Laberinto"
    agenda-group "historia"
    when
        $icaro : Humano(nombre == "Icaro", estadoVida == "vivo", estadoLibertad == "preso")
        $presoIcaro : EstaPresoPor(ser == "Icaro", captor == "Minos")
        TieneCapacidad(ser == "Icaro", capacidad == "Vuelo")
    then
        delete($presoIcaro);
        modify($icaro) { setEstadoLibertad("libre") };
        System.out.println("[Mito] Icaro escapa volando del Laberinto junto a su padre.");
end

rule "Icaro se acerca al sol, sus alas se rompen y muere"
    agenda-group "historia"
    when
        $icaro : Humano(nombre == "Icaro", estadoVida == "vivo", estadoLibertad == "libre")
        $alasIcaro : ObjetoMagico(nombre == "Alas de Icaro", perteneceASer == "Icaro", estaRoto == false)
    then
        modify($alasIcaro) { setEstaRoto(true) };
        modify($icaro) { setEstadoVida("muerto") };
        System.out.println("[Mito] Icaro se acerca demasiado al sol, las Alas de Icaro se rompen y muere.");
end

rule "Dedalo entrega las Alas de Dedalo al heroe con su favor"
    agenda-group "historia"
    salience 5
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneFavorDe(personaje == $h, ser == "Dedalo")
        Humano(nombre == "Dedalo", estadoVida == "vivo", estadoLibertad == "libre")
        $alas : ObjetoMagico(nombre == "Alas de Dedalo", perteneceASer == "Dedalo", estaRoto == false)
        not TieneCapacidad(ser == $h, capacidad == "Vuelo")
    then
        modify($alas) { setPerteneceASer($h) };
        System.out.println("[Mito] Dedalo entrega las Alas de Dedalo a " + $h + ".");
end

rule "Hefesto repara las Alas de Icaro y se las entrega al heroe"
    agenda-group "historia"
    when
        Heroe($h : nombre)
        Personaje(nombre == $h, estadoVida == "vivo", estadoLibertad == "libre")
        TieneFavorDe(personaje == $h, ser == "Hefesto")
        $alasIcaro : ObjetoMagico(nombre == "Alas de Icaro", estaRoto == true)
        not TieneCapacidad(ser == $h, capacidad == "Vuelo")
    then
        modify($alasIcaro) { setEstaRoto(false), setPerteneceASer($h) };
        System.out.println("[Mito] Hefesto repara las Alas de Icaro y se las entrega a " + $h + ".");
end

		
	//Regla para el escenario 8
rule "Zeus revela a su hijo como localizar a las Grayas"
	agenda-group "historia"
	salience 5
	when
		Heroe($h : nombre)
		Personaje(nombre == $h, tienePadre == "Zeus", estadoVida == "vivo", estadoLibertad == "libre")
		TieneFavorDe(personaje == $h, ser == "Zeus")
		not Accion(tipo == "Localizar", agenteAccion == $h, pacienteAccion == "Grayas")
	then
		insert(new Accion("Localizar a las Grayas", "Localizar", $h, "Grayas"));
		System.out.println("[Mito] Zeus ayuda a su hijo " + $h + " y le revela como localizar a las Grayas.");
end

rule "Los heroes entregan sus trofeos al salvador de Andromeda"
    agenda-group "historia"
when
    Accion(tipo == "Liberar", $salvador : agenteAccion,
           pacienteAccion == "Andromeda")
    Heroe(nombre == $salvador)
    Personaje(nombre == $salvador, estadoVida == "vivo",
              estadoLibertad == "libre")

    Heroe($donante : nombre != $salvador)
    Personaje(nombre == $donante, estadoVida == "vivo",
              estadoLibertad == "libre")
    Accion(tipo == "Localizar", agenteAccion == $donante,
           pacienteAccion == "Grayas")

    $trofeo : Trofeo($nombre : nombre, perteneceASer == $donante)
then
    modify($trofeo) { setPerteneceASer($salvador) };
    System.out.println("[Mito] " + $donante + " entrega " + $nombre
        + " a " + $salvador
        + " como reconocimiento por salvar a Andromeda.");
end

rule "Un heroe reune las tres cabezas"
    agenda-group "historia"
    salience -20
when
    Heroe($h : nombre)
    Personaje(nombre == $h, estadoVida == "vivo",
              estadoLibertad == "libre")
    Accion(tipo == "Liberar", pacienteAccion == "Andromeda")

    Trofeo(nombre == "Cabeza de Medusa", perteneceASer == $h)
    Trofeo(nombre == "Cabeza del Minotauro", perteneceASer == $h)
    Trofeo(nombre == "Cabeza de Ceto", perteneceASer == $h)

    not Accion(tipo == "Reunir", agenteAccion == $h,
               pacienteAccion == "Tres cabezas")
then
    insert(new Accion("Reunir las tres cabezas",
                      "Reunir", $h, "Tres cabezas"));
    System.out.println("[Trofeos] " + $h
        + " termina con las cabezas de Medusa, Minotauro y Ceto.");
end