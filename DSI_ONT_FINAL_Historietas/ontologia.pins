;+ (version "3.4.8")
;+ (build "Build 629")

([ontologia_Class23] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Un ser no puede ser padre de si mismo.")
	(%3APAL-NAME "NoAutoParentesco")
	(%3APAL-RANGE "(defrange ?s :FRAME Ser)")
	(%3APAL-STATEMENT "(forall ?s\n        (=> (own-slot-not-null tienePadre ?s)\n            (/= (tienePadre ?s) ?s)))"))

([ontologia_Class24] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Un ser no puede estar preso por si mismo")
	(%3APAL-NAME "NoAutoCaptor")
	(%3APAL-RANGE "(defrange ?s :FRAME Ser)")
	(%3APAL-STATEMENT "(forall ?s\n        (not (tienePresoA ?s ?s)))"))

([ontologia_Class25] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Un personaje no puede tener el favor y el enojo de la misma entidad simultaneamente.")
	(%3APAL-NAME "NoFavorYEnojoSimultaneo")
	(%3APAL-RANGE "(defrange ?p1 :FRAME Personaje)\n(defrange ?p2 :FRAME Personaje)")
	(%3APAL-STATEMENT "(forall ?p1\n        (forall ?p2\n                (=> (tieneFavorDe ?p1 ?p2)\n                    (not (tieneEnfadoDe ?p1 ?p2)))))"))
