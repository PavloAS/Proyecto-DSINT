    <rdfs:comment>Capacidad de convertir a otro ser en piedra.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/dsi/mitologia#Capacidad"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/dsi/mitologia#Invisibilidad">
    <rdfs:label>Invisibilidad</rdfs:label>
    <rdfs:comment>Capacidad de no ser visto.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/dsi/mitologia#Capacidad"/>
  </owl:Class>
</rdf:RDF>