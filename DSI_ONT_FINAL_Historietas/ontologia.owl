<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:mito="https://example.org/dsi/mitologia#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#AnilloInvisibilidad">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#ObjetoMagico"/>
    <rdfs:label>AnilloInvisibilidad</rdfs:label>
    <rdfs:comment>Ejemplo de ObjetoMagico dentro de los mitos del proyecto.</rdfs:comment>
    <mito:otorgaCapacidad>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#SerInvisible">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Invisibilidad"/>
        <rdfs:label>SerInvisible</rdfs:label>
        <rdfs:comment>Ejemplo de Invisibilidad dentro de los mitos del proyecto.</rdfs:comment>
      </owl:NamedIndividual>
    </mito:otorgaCapacidad>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#mata">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Ser"/>
    <rdfs:label>mata</rdfs:label>
    <rdfs:comment>Un personaje mata a otro ser.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Danae">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Humano"/>
    <rdfs:label>Danae</rdfs:label>
    <rdfs:comment>Ejemplo de Humano dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Danae</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Hermes">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Dios"/>
    <rdfs:label>Hermes</rdfs:label>
    <rdfs:comment>Ejemplo de Dios dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Hermes</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
    <mito:tieneObjeto>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#HozAcero">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Arma"/>
        <rdfs:label>HozAcero</rdfs:label>
        <rdfs:comment>Ejemplo de Arma dentro de los mitos del proyecto.</rdfs:comment>
      </owl:NamedIndividual>
    </mito:tieneObjeto>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Pegaso">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#AnimalMitologico"/>
    <rdfs:label>Pegaso</rdfs:label>
    <rdfs:comment>Ejemplo de AnimalMitologico dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Pegaso</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Ceto">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Monstruo"/>
    <rdfs:label>Ceto</rdfs:label>
    <rdfs:comment>Ejemplo de Monstruo dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Ceto</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
    <mito:apresa>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Andromeda">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Humano"/>
        <rdfs:label>Andromeda</rdfs:label>
        <rdfs:comment>Ejemplo de Humano dentro de los mitos del proyecto.</rdfs:comment>
        <mito:nombre>Andromeda</mito:nombre>
        <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
        <mito:estaLibre rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaLibre>
      </owl:NamedIndividual>
    </mito:apresa>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://example.org/dsi/mitologia#nombre">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Ser"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>nombre</rdfs:label>
    <rdfs:comment>Nombre usado para identificar al ser.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Ninfas">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Grupo"/>
    <rdfs:label>Ninfas</rdfs:label>
    <rdfs:comment>Ejemplo de Grupo dentro de los mitos del proyecto.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#CuernoMinotauro">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Arma"/>
    <rdfs:label>CuernoMinotauro</rdfs:label>
    <rdfs:comment>Ejemplo de Arma dentro de los mitos del proyecto.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Hefesto">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Dios"/>
    <rdfs:label>Hefesto</rdfs:label>
    <rdfs:comment>Ejemplo de Dios dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Hefesto</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
    <mito:tieneObjeto>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#BridaOro">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Herramienta"/>
        <rdfs:label>BridaOro</rdfs:label>
        <rdfs:comment>Ejemplo de Herramienta dentro de los mitos del proyecto.</rdfs:comment>
      </owl:NamedIndividual>
    </mito:tieneObjeto>
    <mito:favorece>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Perseo">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Heroe"/>
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Semidios"/>
        <rdfs:label>Perseo</rdfs:label>
        <rdfs:comment>Ejemplo de Heroe, Semidios dentro de los mitos del proyecto.</rdfs:comment>
        <mito:nombre>Perseo</mito:nombre>
        <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
        <mito:participaEn rdf:resource="https://example.org/dsi/mitologia#RescateAndromeda"/>
        <mito:realizaAccion rdf:resource="https://example.org/dsi/mitologia#DerrotarMedusa"/>
        <mito:localiza rdf:resource="https://example.org/dsi/mitologia#Medusa"/>
        <mito:tieneCapacidad rdf:resource="https://example.org/dsi/mitologia#Volar"/>
        <mito:estaLibre rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaLibre>
      </owl:NamedIndividual>
    </mito:favorece>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#objetivoDe">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Mision"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:label>objetivoDe</rdfs:label>
    <rdfs:comment>Personaje al que afecta el objetivo de la mision.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Zeus">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Dios"/>
    <rdfs:label>Zeus</rdfs:label>
    <rdfs:comment>Ejemplo de Dios dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Zeus</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
    <mito:esPadreDe rdf:resource="https://example.org/dsi/mitologia#Perseo"/>
    <mito:esPadreDe>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Heracles">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Heroe"/>
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Semidios"/>
        <rdfs:label>Heracles</rdfs:label>
        <rdfs:comment>Ejemplo de Heroe, Semidios dentro de los mitos del proyecto.</rdfs:comment>
        <mito:nombre>Heracles</mito:nombre>
        <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
        <mito:estaLibre rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaLibre>
      </owl:NamedIndividual>
    </mito:esPadreDe>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Atenea">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Dios"/>
    <rdfs:label>Atenea</rdfs:label>
    <rdfs:comment>Ejemplo de Dios dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Atenea</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
    <mito:tieneObjeto>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#EscudoBronce">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Proteccion"/>
        <rdfs:label>EscudoBronce</rdfs:label>
        <rdfs:comment>Ejemplo de Proteccion dentro de los mitos del proyecto.</rdfs:comment>
      </owl:NamedIndividual>
    </mito:tieneObjeto>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://example.org/dsi/mitologia#estaRoto">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Objeto"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>estaRoto</rdfs:label>
    <rdfs:comment>Indica si el objeto necesita reparacion.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#CeraAbejas">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Objeto"/>
    <rdfs:label>CeraAbejas</rdfs:label>
    <rdfs:comment>Ejemplo de Objeto dentro de los mitos del proyecto.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#construye">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Objeto"/>
    <rdfs:label>construye</rdfs:label>
    <rdfs:comment>Un personaje construye un objeto.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#apresa">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Ser"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:label>apresa</rdfs:label>
    <rdfs:comment>Un ser mantiene prisionero a un personaje.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Plumas">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Objeto"/>
    <rdfs:label>Plumas</rdfs:label>
    <rdfs:comment>Ejemplo de Objeto dentro de los mitos del proyecto.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://example.org/dsi/mitologia#orden">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Accion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>orden</rdfs:label>
    <rdfs:comment>Numero orientativo para ordenar una accion en una traza.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#repara">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Objeto"/>
    <rdfs:label>repara</rdfs:label>
    <rdfs:comment>Un personaje repara un objeto.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Grayas">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Grupo"/>
    <rdfs:label>Grayas</rdfs:label>
    <rdfs:comment>Ejemplo de Grupo dentro de los mitos del proyecto.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#participaEn">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Mision"/>
    <rdfs:label>participaEn</rdfs:label>
    <rdfs:comment>Un personaje participa en una mision.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Hades">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Dios"/>
    <rdfs:label>Hades</rdfs:label>
    <rdfs:comment>Ejemplo de Dios dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Hades</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
    <mito:tieneObjeto>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#CascoHades">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#ObjetoMagico"/>
        <rdfs:label>CascoHades</rdfs:label>
        <rdfs:comment>Ejemplo de ObjetoMagico dentro de los mitos del proyecto.</rdfs:comment>
        <mito:otorgaCapacidad rdf:resource="https://example.org/dsi/mitologia#SerInvisible"/>
      </owl:NamedIndividual>
    </mito:tieneObjeto>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Dedalo">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Humano"/>
    <rdfs:label>Dedalo</rdfs:label>
    <rdfs:comment>Ejemplo de Humano dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Dedalo</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
    <mito:tieneObjeto>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#AlasDedalo">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Herramienta"/>
        <rdfs:label>AlasDedalo</rdfs:label>
        <rdfs:comment>Ejemplo de Herramienta dentro de los mitos del proyecto.</rdfs:comment>
        <mito:otorgaCapacidad rdf:resource="https://example.org/dsi/mitologia#Volar"/>
      </owl:NamedIndividual>
    </mito:tieneObjeto>
    <mito:esPadreDe>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Icaro">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Humano"/>
        <rdfs:label>Icaro</rdfs:label>
        <rdfs:comment>Ejemplo de Humano dentro de los mitos del proyecto.</rdfs:comment>
        <mito:nombre>Icaro</mito:nombre>
        <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
        <mito:tieneObjeto rdf:resource="https://example.org/dsi/mitologia#AlasIcaro"/>
        <mito:estaLibre rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaLibre>
      </owl:NamedIndividual>
    </mito:esPadreDe>
    <mito:construye rdf:resource="https://example.org/dsi/mitologia#AlasDedalo"/>
    <mito:repara>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#AlasIcaro">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Herramienta"/>
        <rdfs:label>AlasIcaro</rdfs:label>
        <rdfs:comment>Ejemplo de Herramienta dentro de los mitos del proyecto.</rdfs:comment>
        <mito:otorgaCapacidad rdf:resource="https://example.org/dsi/mitologia#Volar"/>
        <mito:estaRoto rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaRoto>
      </owl:NamedIndividual>
    </mito:repara>
    <mito:estaLibre rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaLibre>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#estaEn">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Ser"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Lugar"/>
    <rdfs:label>estaEn</rdfs:label>
    <rdfs:comment>Lugar donde se encuentra un ser.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/dsi/mitologia#estaVivo">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Ser"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>estaVivo</rdfs:label>
    <rdfs:comment>Estado de vida al inicio de un escenario.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#libera">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:label>libera</rdfs:label>
    <rdfs:comment>Un personaje libera a otro.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://example.org/dsi/mitologia#OntologiaMitologia">
    <rdfs:label>Mitologia griega - Proyecto DSI</rdfs:label>
    <rdfs:comment>Modelo de personajes, objetos, capacidades y relaciones para los mitos de Andromeda y del laberinto de Creta. Las acciones y su orden se implementan en Drools.</rdfs:comment>
    <rdfs:comment>Los individuos y relaciones incluidos son ejemplos para validar la ontologia; no se deben importar como hechos verdaderos en todos los escenarios. Drools debe crear los hechos iniciales adecuados para cada archivo.</rdfs:comment>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#objetoEstaEn">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Objeto"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Lugar"/>
    <rdfs:label>objetoEstaEn</rdfs:label>
    <rdfs:comment>Lugar donde se encuentra un objeto.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Kraken">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Monstruo"/>
    <rdfs:label>Kraken</rdfs:label>
    <rdfs:comment>Ejemplo de Monstruo dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Kraken</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#EscudoEspejo">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Proteccion"/>
    <rdfs:label>EscudoEspejo</rdfs:label>
    <rdfs:comment>Ejemplo de Proteccion dentro de los mitos del proyecto.</rdfs:comment>
    <mito:otorgaCapacidad>
      <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#UsarReflejo">
        <rdf:type rdf:resource="https://example.org/dsi/mitologia#Reflejo"/>
        <rdfs:label>UsarReflejo</rdfs:label>
        <rdfs:comment>Ejemplo de Reflejo dentro de los mitos del proyecto.</rdfs:comment>
      </owl:NamedIndividual>
    </mito:otorgaCapacidad>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#realizaAccion">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Accion"/>
    <rdfs:label>realizaAccion</rdfs:label>
    <rdfs:comment>Un personaje lleva a cabo una accion.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#Minos">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Humano"/>
    <rdfs:label>Minos</rdfs:label>
    <rdfs:comment>Ejemplo de Humano dentro de los mitos del proyecto.</rdfs:comment>
    <mito:nombre>Minos</mito:nombre>
    <mito:estaVivo rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mito:estaVivo>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#enojaA">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Dios"/>
    <rdfs:label>enojaA</rdfs:label>
    <rdfs:comment>Un personaje provoca el enojo de un dios.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#CabezaMinotauro">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Trofeo"/>
    <rdfs:label>CabezaMinotauro</rdfs:label>
    <rdfs:comment>Ejemplo de Trofeo dentro de los mitos del proyecto.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://example.org/dsi/mitologia#ayudaA">
    <rdfs:domain rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:range rdf:resource="https://example.org/dsi/mitologia#Personaje"/>
    <rdfs:label>ayudaA</rdfs:label>
    <rdfs:comment>Un personaje ayuda a otro.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://example.org/dsi/mitologia#FuerzaDescomunal">
    <rdf:type rdf:resource="https://example.org/dsi/mitologia#Fuerza"/>
    <rdfs:label>FuerzaDescomunal</rdfs:label>
    <rdfs:comment>Ejemplo de Fuerza dentro de los mitos del proyecto.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://example.org/dsi/mitologia#estaLibre">
