		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write)))

(defclass Reflejo "Permite concretamente a mirar el reflejo de Medusa sin quedarse petrificado gracias al escudo espejo."
	(is-a CapacIdad)
	(role concrete))

(defclass Fuerza "Fuerza especial que tienen personajes concretos como Heracles para matar monstruos con sus propias manos sin usar armas."
	(is-a CapacIdad)
	(role concrete))

(defclass Vuelo "Permite al personaje que la tenga volar."
	(is-a CapacIdad)
	(role concrete))

(defclass Petrificacion "Capacidad de petrificar a otros seres."
	(is-a CapacIdad)
	(role concrete))

(defclass Invisibilidad "Permite que el personaje que la tenga no sea visto. Sera util para diversas misiones."
	(is-a CapacIdad)
	(role concrete))

