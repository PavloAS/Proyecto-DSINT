		(create-accessor read-write)))

(defclass Dios "Deidades de la mitologia griega. Pueden dar su favor a los heroes, enfadarse, entregar objetos...\nRef:\nhttps://es.wikipedia.org/wiki/Dioses_olimpicos"
	(is-a Personaje)
	(role concrete))

(defclass Semidios "Hijos de un dios y un mortal. Suelen ser los protagonistas de las misiones"
	(is-a Personaje)
	(role concrete))

(defclass Humano "Mortales normales que aparecen en las historias como victimas o ayudantes."
	(is-a Personaje)
	(role concrete))

(defclass Heroe "Personajes mortales que realizan las misiones principales aunque no sean semidioses."
	(is-a Personaje)
	(role concrete))

(defclass Criatura "Seres mitologicos que no son humanos ni dioses. Pueden ser animales mitologicos o monstruos a los que hay que derrotar."
	(is-a Ser)
	(role abstract))

(defclass Monstruo "Criaturas peligrosas a las que los heroes tienen que matar en los mitos. Nos basamos en el guion de practicas y en el documento siguiente:\nhttps://es.wikipedia.org/wiki/Monstruos_de_la_mitologia_griega"
	(is-a Criatura)
	(role concrete))

(defclass AnimalMitologico "Criaturas que son pacificas. Pueden audar o ser domadas por los heroes."
	(is-a Criatura)
	(role concrete))

(defclass Objeto "Cualquier objeto, ya sea arma o materia,l que un ser puede tener en su inventario o conseguir en una mision."
	(is-a USER)
	(role concrete)
	(single-slot perteneceASer
;+		(comment "Objetos que tiene un ser en su poder.")
		(type INSTANCE)
;+		(allowed-classes Ser)
;+		(cardinality 0 1)
		(create-accessor read-write))
	(multislot otorgaCapacidad
;+		(comment "Relaciona un objeto con la capacidad que le da al personaje que lo posee.")
		(type INSTANCE)
;+		(allowed-classes CapacIdad)
		(create-accessor read-write))
	(single-slot estaRoto
;+		(comment "Booleano para saber si un objeto esta roto y hace falta repararlo.")
		(type SYMBOL)
		(allowed-values FALSE TRUE)
		(default FALSE)
;+		(cardinality 0 1)
		(create-accessor read-write))
	(single-slot nombre
;+		(comment "Nombre del ser, objeto o lugar.")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write)))

(defclass Arma "Objetos que sirven para atacar y matar criaturas."
	(is-a Objeto)
	(role concrete))

(defclass Proteccion "Objetevos que sirven como defensa, utilizados por los seres."
	(is-a Objeto)
	(role concrete))

(defclass ObjetoMagico "Objetos especiales de los mitos que dan alguna capacidad al personaje que los lleva."
	(is-a Objeto)
	(role concrete))

(defclass Herramienta "Objetos o materiales que sirven para orientarse, para domar criaturas o para fabricar otras cosas."
	(is-a Objeto)
	(role concrete))

(defclass Trofeo "Partes de una criatura que se consiguen al detorrarlos."
	(is-a Objeto)
	(role concrete))

(defclass CapacIdad "Habilidades especiales que necesita un personaje para superar partes del mito."
	(is-a USER)
	(role abstract)
	(multislot esOtorgadaPor
;+		(comment "Relaciona un objeto con la capacidad que le da al personaje que lo posee.")
		(type INSTANCE)
