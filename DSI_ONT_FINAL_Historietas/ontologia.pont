(defclass Personaje "Seres racionales que interactuan en la historia dando favores, enfadandose o realizando misiones."
	(is-a Ser)
	(role abstract)
	(multislot tieneEnfadoDe
;+		(comment "Indica el ser con el que esta enfadado un personaje.")
		(type INSTANCE)
;+		(allowed-classes Ser)
		(create-accessor read-write))
